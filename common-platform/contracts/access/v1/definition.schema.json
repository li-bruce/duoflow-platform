{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "module_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,79}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "scope_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,79}$"
      },
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,159}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "guards": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "enum": [
                        "actor_not_fact",
                        "actor_is_fact"
                      ]
                    },
                    "fact": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,79}$"
                    }
                  },
                  "required": [
                    "type",
                    "fact"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "fact_in"
                    },
                    "fact": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,79}$"
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "minItems": 1,
                      "maxItems": 100,
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "type",
                    "fact",
                    "values"
                  ]
                }
              ]
            },
            "minItems": 0,
            "maxItems": 20,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "title"
        ]
      },
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true
    },
    "role_templates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,159}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,159}$"
            },
            "minItems": 1,
            "maxItems": 200,
            "uniqueItems": true
          },
          "required_scope": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,79}$"
            },
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "title",
          "permissions",
          "required_scope"
        ]
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "command_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "capability_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,159}$"
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "permission": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,159}$"
          }
        },
        "required": [
          "capability_id",
          "permission"
        ]
      },
      "minItems": 0,
      "maxItems": 300,
      "uniqueItems": true
    },
    "experiences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,159}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "flow_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,159}$"
          },
          "required_permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,159}$"
            },
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true
          },
          "step_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,159}$"
            },
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "flow_id",
          "required_permissions"
        ]
      },
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true
    },
    "workitem_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,159}$"
          },
          "capability_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,159}$"
          },
          "experience_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,159}$"
          }
        },
        "required": [
          "id",
          "capability_id",
          "experience_id"
        ]
      },
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true
    }
  },
  "required": [
    "contract_version",
    "module_id",
    "version",
    "title",
    "scope_keys",
    "permissions",
    "role_templates",
    "command_mappings",
    "experiences",
    "workitem_sources"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:common-platform:access-definition:1.0"
}
