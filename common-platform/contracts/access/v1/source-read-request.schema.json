{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Read a registered source object with a current consumer ticket v1.0",
  "type":"object",
  "additionalProperties":false,
  "required":["source_read_version","request_id","operation","permission","facts","source"],
  "properties":{
    "source_read_version":{"const":"1.0"},
    "request_id":{"$ref":"#/$defs/identifier"},
    "operation":{"$ref":"#/$defs/identifier"},
    "permission":{"$ref":"#/$defs/identifier"},
    "facts":{"type":"object","maxProperties":32,"propertyNames":{"pattern":"^[a-z][a-z0-9_]{0,79}$"},"additionalProperties":{"oneOf":[{"type":"string","minLength":1,"maxLength":160},{"type":"array","minItems":1,"maxItems":20,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":160}}]}},
    "source":{"type":"object","additionalProperties":false,"required":["module_id","object_ref","revision"],"properties":{
      "module_id":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{2,119}$"},
      "object_ref":{"type":"object","additionalProperties":false,"required":["object_type","object_id"],"properties":{"object_type":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,99}$"},"object_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"}}},
      "revision":{"type":"integer","minimum":1}
    }},
    "read_input":{"type":"object","maxProperties":16,"propertyNames":{"pattern":"^[a-z][a-z0-9_]{0,79}$","not":{"enum":["object_ref","actor","context","url","operation","capability_id","ticket","token"]}}}
  },
  "$defs":{"identifier":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"}}
}
