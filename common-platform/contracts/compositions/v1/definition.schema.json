{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DuoFlow composition 1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "composition_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "input_schema": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "module_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "flow_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "flow_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "bindings": {
            "type": "object",
            "maxProperties": 50,
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "source": {
                      "const": "input"
                    },
                    "path": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 12,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      }
                    }
                  },
                  "required": [
                    "source",
                    "path"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "source": {
                      "const": "step"
                    },
                    "step_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[a-z][a-z0-9_.-]*$"
                    },
                    "path": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 12,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      }
                    }
                  },
                  "required": [
                    "source",
                    "step_id",
                    "path"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "source": {
                      "const": "literal"
                    },
                    "value": {}
                  },
                  "required": [
                    "source",
                    "value"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "module_id",
          "flow_id",
          "flow_version",
          "bindings"
        ]
      }
    },
    "roles": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "bindings": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "module_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "role_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "scope": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 20,
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                }
              },
              "required": [
                "module_id",
                "role_id",
                "scope"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "bindings"
        ]
      }
    }
  },
  "required": [
    "composition_version",
    "id",
    "version",
    "title",
    "description",
    "input_schema",
    "steps",
    "roles"
  ]
}
