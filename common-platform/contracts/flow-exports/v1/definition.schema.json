{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "exports_version": {
      "const": "1.0"
    },
    "module_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,120}$"
    },
    "module_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,120}$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "entry": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "capability"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.-]{2,120}$"
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  }
                },
                "required": [
                  "kind",
                  "id",
                  "version"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "workflow"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.-]{2,120}$"
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "completed_states": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "minItems": 1,
                    "maxItems": 64,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "kind",
                  "id",
                  "version",
                  "completed_states"
                ],
                "additionalProperties": false
              }
            ]
          },
          "node_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{2,120}$"
            },
            "minItems": 1,
            "maxItems": 512,
            "uniqueItems": true
          },
          "required_permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{2,120}$"
            },
            "minItems": 0,
            "maxItems": 64,
            "uniqueItems": true
          },
          "data_access": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "object_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{2,120}$"
                },
                "operations": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "list",
                      "read",
                      "create",
                      "update",
                      "delete"
                    ]
                  },
                  "minItems": 1,
                  "maxItems": 5,
                  "uniqueItems": true
                }
              },
              "required": [
                "object_id",
                "operations"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 64,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "version",
          "title",
          "description",
          "entry",
          "node_ids",
          "required_permissions",
          "data_access"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    }
  },
  "required": [
    "exports_version",
    "module_id",
    "module_version",
    "flows"
  ],
  "additionalProperties": false
}
