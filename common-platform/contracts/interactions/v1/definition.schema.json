{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interaction component definition v1",
  "type": "object", "additionalProperties": false,
  "required": ["protocol_version", "id", "version", "title", "description", "input_schema", "state_schema", "initial_state", "actions"],
  "properties": {
    "protocol_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,100}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 80},
    "description": {"type": "string", "minLength": 1, "maxLength": 1200},
    "triggers": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 4, "maxLength": 100}},
    "input_schema": {"type": "object"},
    "state_schema": {"type": "object"},
    "initial_state": {"type": "object"},
    "actions": {"type": "array", "minItems": 1, "maxItems": 12, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "capability_id", "capability_version", "bindings", "completes"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,60}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 80},
        "capability_id": {"type": "string", "minLength": 3, "maxLength": 120},
        "capability_version": {"type": "string", "minLength": 1, "maxLength": 30},
        "completes": {"type": "boolean"},
        "bindings": {"type": "object", "maxProperties": 40, "additionalProperties": {
          "type": "object", "additionalProperties": false, "required": ["source", "key"],
          "properties": {"source": {"enum": ["input", "state"]}, "key": {"type": "string", "minLength": 1, "maxLength": 100}}
        }}
      }
    }}
  }
}
