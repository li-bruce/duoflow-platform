{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DuoFlow module atoms and business-node mapping",
  "type": "object",
  "properties": {
    "graph_version": {
      "const": "1.0"
    },
    "module_id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,159}$"
    },
    "module_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "atoms": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,159}$"
              },
              "kind": {
                "const": "backend"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "source": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^(?![/\\\\])(?!(?:.*[/\\\\])?\\.\\.(?:[/\\\\]|$))[A-Za-z0-9_./-]+$",
                    "maxLength": 240
                  },
                  "symbol": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,159}$"
                  }
                },
                "required": [
                  "path",
                  "symbol"
                ],
                "additionalProperties": false
              },
              "capability": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,159}$"
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                  }
                },
                "required": [
                  "id",
                  "version"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "kind",
              "title",
              "description",
              "source",
              "capability"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,159}$"
              },
              "kind": {
                "const": "frontend"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "source": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^(?![/\\\\])(?!(?:.*[/\\\\])?\\.\\.(?:[/\\\\]|$))[A-Za-z0-9_./-]+$",
                    "maxLength": 240
                  },
                  "symbol": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,159}$"
                  }
                },
                "required": [
                  "path",
                  "symbol"
                ],
                "additionalProperties": false
              },
              "host": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "interaction",
                      "workflow_step"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,159}$"
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                  },
                  "step_id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,159}$"
                  }
                },
                "required": [
                  "kind",
                  "id",
                  "version"
                ],
                "additionalProperties": false
              },
              "input_schema": {
                "type": "object"
              },
              "output_schema": {
                "type": "object"
              },
              "state_schema": {
                "type": "object"
              },
              "initial_state": {
                "type": "object"
              },
              "events": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,159}$"
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    },
                    "input_schema": {
                      "type": "object"
                    },
                    "output_schema": {
                      "type": "object"
                    },
                    "effect": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    },
                    "state_effect": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    },
                    "capability": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,159}$"
                        },
                        "version": {
                          "type": "string",
                          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                        }
                      },
                      "required": [
                        "id",
                        "version"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "input_schema",
                    "output_schema",
                    "effect",
                    "state_effect"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 64
              }
            },
            "required": [
              "id",
              "kind",
              "title",
              "description",
              "source",
              "host",
              "input_schema",
              "output_schema",
              "state_schema",
              "initial_state",
              "events"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1,
      "maxItems": 256
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,159}$"
          },
          "kind": {
            "enum": [
              "business",
              "state",
              "data",
              "decision"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "atom_id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,159}$"
          },
          "node_id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,159}$"
          },
          "role": {
            "enum": [
              "handles",
              "shows",
              "reads",
              "writes"
            ]
          },
          "event_id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,159}$"
          }
        },
        "required": [
          "atom_id",
          "node_id",
          "role"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 2000
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,159}$"
          },
          "from": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,159}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,159}$"
          },
          "kind": {
            "enum": [
              "sequence",
              "call",
              "response",
              "data",
              "transition"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "kind",
          "title"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 2000
    },
    "state_machines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,159}$"
          },
          "scope": {
            "enum": [
              "business",
              "component",
              "execution"
            ]
          },
          "owner_id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,159}$"
          },
          "initial": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,159}$"
          },
          "states": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,159}$"
                },
                "node_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,159}$"
                }
              },
              "required": [
                "id",
                "node_id"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 100
          },
          "transitions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,159}$"
                },
                "from": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,159}$"
                },
                "to": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,159}$"
                },
                "event": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,159}$"
                }
              },
              "required": [
                "id",
                "from",
                "to",
                "event"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 500
          }
        },
        "required": [
          "id",
          "scope",
          "owner_id",
          "initial",
          "states",
          "transitions"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "required": [
    "graph_version",
    "module_id",
    "module_version",
    "version",
    "atoms",
    "nodes",
    "mappings",
    "edges",
    "state_machines"
  ],
  "additionalProperties": false
}
