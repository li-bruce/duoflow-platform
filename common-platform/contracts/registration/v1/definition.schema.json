{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "registration_version": {
      "const": "1.0"
    },
    "module_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9_.-]{2,120}$"
    },
    "module_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "permissions": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "platform_access",
            "capability_roles"
          ]
        },
        "definition": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "mode",
        "definition"
      ],
      "additionalProperties": false
    },
    "data_objects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z][a-z0-9_.-]{2,120}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "schema": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "object"
              }
            }
          },
          "operations": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "list": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[a-z][a-z0-9_.-]{2,120}$"
              },
              "read": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[a-z][a-z0-9_.-]{2,120}$"
              },
              "create": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[a-z][a-z0-9_.-]{2,120}$"
              },
              "update": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[a-z][a-z0-9_.-]{2,120}$"
              },
              "delete": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[a-z][a-z0-9_.-]{2,120}$"
              }
            }
          },
          "scope_fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "maxItems": 32,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "schema",
          "operations",
          "scope_fields"
        ],
        "additionalProperties": false
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "business_chains": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z][a-z0-9_.-]{2,120}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "entry_capability": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z][a-z0-9_.-]{2,120}$"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[a-z][a-z0-9_.-]{2,120}$"
            },
            "maxItems": 20,
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "entry_capability",
          "steps"
        ],
        "additionalProperties": false
      },
      "maxItems": 30,
      "uniqueItems": true
    },
    "host_requirements": {
      "type": "object",
      "properties": {
        "workflows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[a-z][a-z0-9_.-]{2,120}$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            },
            "required": [
              "id",
              "version"
            ],
            "additionalProperties": false
          },
          "maxItems": 32,
          "uniqueItems": true
        },
        "interactions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[a-z][a-z0-9_.-]{2,120}$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            },
            "required": [
              "id",
              "version"
            ],
            "additionalProperties": false
          },
          "maxItems": 32,
          "uniqueItems": true
        }
      },
      "required": [
        "workflows",
        "interactions"
      ],
      "additionalProperties": false
    },
    "workflow_operations": {
      "type": "array",
      "items": {
        "enum": [
          "objects.list",
          "objects.read",
          "objects.detail",
          "uploads.create",
          "uploads.status",
          "uploads.complete",
          "uploads.abort",
          "jobs.status",
          "jobs.result",
          "jobs.cancel"
        ]
      },
      "maxItems": 16,
      "uniqueItems": true
    },
    "ai_services": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,119}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "capability_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{2,119}$"
            }
          },
          "supported_sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "platform",
                "module"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "capability_ids",
          "supported_sources"
        ]
      }
    },
    "coordination": {
      "type": "object",
      "properties": {
        "version": {
          "const": "1.0"
        },
        "machines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,159}$"
              },
              "object_types": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 120,
                  "pattern": "^[a-z][a-z0-9_.-]{2,119}$"
                },
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true
              },
              "states": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,127}$"
                },
                "minItems": 1,
                "maxItems": 100,
                "uniqueItems": true
              },
              "public_states": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,127}$"
                },
                "minItems": 0,
                "maxItems": 100,
                "uniqueItems": true
              },
              "approval_required": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "object_types",
              "states",
              "public_states",
              "approval_required"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        },
        "emits": {
          "type": "array",
          "items": {
            "enum": [
              "state.changed",
              "publication.requested",
              "resource.published",
              "resource.withdrawn"
            ]
          },
          "minItems": 0,
          "maxItems": 4,
          "uniqueItems": true
        },
        "accepts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_module": {
                "type": "string",
                "minLength": 3,
                "maxLength": 120,
                "pattern": "^[a-z][a-z0-9_.-]{2,119}$"
              },
              "kind": {
                "enum": [
                  "state.changed",
                  "resource.published",
                  "resource.withdrawn"
                ]
              },
              "mode": {
                "enum": [
                  "notify",
                  "sync"
                ]
              }
            },
            "required": [
              "source_module",
              "kind",
              "mode"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        }
      },
      "required": [
        "version",
        "machines",
        "emits",
        "accepts"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "registration_version",
    "module_id",
    "module_version",
    "permissions",
    "data_objects",
    "business_chains",
    "host_requirements",
    "workflow_operations"
  ],
  "additionalProperties": false
}
