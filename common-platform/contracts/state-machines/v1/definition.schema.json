{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Declarative business state machine v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "initial", "states", "transitions"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,119}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 30},
    "initial": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,119}$"},
    "states": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "title"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,119}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 160},
          "terminal": {"type": "boolean"}
        }
      }
    },
    "transitions": {
      "type": "array", "maxItems": 300,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "from", "to", "step_id", "action_id"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,119}$"},
          "from": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,119}$"},
          "to": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,119}$"},
          "step_id": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,119}$"},
          "action_id": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,119}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 160},
          "guard_description": {"type": "string", "maxLength": 2000}
        }
      }
    }
  }
}
