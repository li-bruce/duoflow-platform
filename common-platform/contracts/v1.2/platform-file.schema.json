{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "filename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "media_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "content_base64": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5592408
    }
  },
  "required": [
    "filename",
    "media_type",
    "content_base64"
  ],
  "additionalProperties": false,
  "format": "platform-file",
  "description": "单个文件最多 4 MiB；正文为 base64，不接受文件路径或 URL。"
}
