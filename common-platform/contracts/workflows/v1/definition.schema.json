{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Installed workflow definitions 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "flows"
  ],
  "properties": {
    "flows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocol_version",
          "id",
          "version",
          "title",
          "description",
          "provider",
          "initial_step",
          "steps"
        ],
        "properties": {
          "protocol_version": {
            "const": "1.0"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "maxLength": 3000
          },
          "triggers": {
            "type": "array",
            "maxItems": 30,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "provider": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "object_type",
              "read_capability"
            ],
            "properties": {
              "object_type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[a-z][a-z0-9_.-]{0,99}$"
              },
              "related_object_types": {
                "type": "array",
                "maxItems": 5,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,99}$"
                }
              },
              "read_capability": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
              },
              "upload_capability": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
              },
              "jobs_capability": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
              }
            }
          },
          "initial_step": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
          },
          "page_groups": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "steps"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "steps": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                }
              }
            }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 40,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "description",
                "component",
                "actions"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "description": {
                  "type": "string",
                  "maxLength": 3000
                },
                "component": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
                },
                "triggers": {
                  "type": "array",
                  "uniqueItems": true,
                  "maxItems": 30,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                },
                "actions": {
                  "type": "array",
                  "maxItems": 30,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "title",
                      "capability_id",
                      "capability_version",
                      "command_schema"
                    ],
                    "allOf": [
                      {
                        "if": {
                          "required": [
                            "mode"
                          ],
                          "properties": {
                            "mode": {
                              "const": "draft_query"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "creates_object": {
                              "const": false
                            }
                          }
                        }
                      }
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120,
                        "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "capability_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120,
                        "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
                      },
                      "capability_version": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 30
                      },
                      "command_schema": {
                        "type": "object"
                      },
                      "creates_object": {
                        "type": "boolean"
                      },
                      "target_step": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120,
                        "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
                      },
                      "mode": {
                        "enum": [
                          "object_command",
                          "draft_query"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "state_machine": {
            "$ref": "#/$defs/state_machine"
          }
        }
      }
    }
  },
  "$defs": {
    "state_machine": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Declarative business state machine v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "initial",
        "states",
        "transitions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,119}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "initial": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,119}$"
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,119}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "terminal": {
                "type": "boolean"
              }
            }
          }
        },
        "transitions": {
          "type": "array",
          "maxItems": 300,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "from",
              "to",
              "step_id",
              "action_id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,119}$"
              },
              "from": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,119}$"
              },
              "to": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,119}$"
              },
              "step_id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,119}$"
              },
              "action_id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,119}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "guard_description": {
                "type": "string",
                "maxLength": 2000
              }
            }
          }
        }
      }
    }
  }
}
