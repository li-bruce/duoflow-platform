{
  "flows": [
    {
      "protocol_version": "1.0",
      "id": "framework-lab.workflow",
      "version": "1.0.0",
      "title": "通用工作项实验室",
      "description": "一个中立案例验证前后端组件、声明、真实状态机与页面／对话协同。",
      "triggers": [
        "打开通用工作项实验室",
        "调试通用工作项"
      ],
      "provider": {
        "object_type": "framework-lab.item",
        "read_capability": "framework-lab.read"
      },
      "initial_step": "pick",
      "page_groups": [
        {
          "id": "workspace",
          "title": "本人工作台",
          "steps": [
            "pick",
            "edit",
            "inspect"
          ]
        }
      ],
      "steps": [
        {
          "id": "pick",
          "title": "选择或创建",
          "description": "每个人只能查看自己的调试工作项。",
          "component": "Picker",
          "actions": [
            {
              "id": "create",
              "title": "创建工作项",
              "capability_id": "framework-lab.create",
              "capability_version": "1.0.0",
              "command_schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "body": {
                    "type": "string",
                    "maxLength": 4000
                  }
                },
                "required": [
                  "title",
                  "body"
                ],
                "additionalProperties": false
              },
              "creates_object": true,
              "target_step": "edit"
            }
          ]
        },
        {
          "id": "edit",
          "title": "填写与提交",
          "description": "填写说明，保存正式内容后再提交；导航步骤不改变正式状态。",
          "component": "Editor",
          "actions": [
            {
              "id": "edit",
              "title": "保存工作项",
              "capability_id": "framework-lab.edit",
              "capability_version": "1.0.0",
              "command_schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "body": {
                    "type": "string",
                    "maxLength": 4000
                  }
                },
                "required": [
                  "title",
                  "body"
                ],
                "additionalProperties": false
              }
            },
            {
              "id": "submit",
              "title": "提交工作项",
              "capability_id": "framework-lab.submit",
              "capability_version": "1.0.0",
              "command_schema": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": false
              },
              "target_step": "inspect"
            }
          ]
        },
        {
          "id": "inspect",
          "title": "处理与记录",
          "description": "由本人模拟完成或退回，以验证真实状态机；此样例不是多人审批规则。",
          "component": "Inspector",
          "actions": [
            {
              "id": "return",
              "title": "模拟退回",
              "capability_id": "framework-lab.return",
              "capability_version": "1.0.0",
              "command_schema": {
                "type": "object",
                "properties": {
                  "note": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  }
                },
                "required": [
                  "note"
                ],
                "additionalProperties": false
              },
              "target_step": "edit"
            },
            {
              "id": "complete",
              "title": "模拟完成",
              "capability_id": "framework-lab.complete",
              "capability_version": "1.0.0",
              "command_schema": {
                "type": "object",
                "properties": {
                  "note": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  }
                },
                "required": [
                  "note"
                ],
                "additionalProperties": false
              }
            }
          ]
        }
      ],
      "state_machine": {
        "id": "framework-lab.item-lifecycle",
        "version": "1.0.0",
        "initial": "draft",
        "states": [
          {
            "id": "draft",
            "title": "草稿"
          },
          {
            "id": "submitted",
            "title": "已提交"
          },
          {
            "id": "returned",
            "title": "已退回"
          },
          {
            "id": "completed",
            "title": "已完成",
            "terminal": true
          }
        ],
        "transitions": [
          {
            "id": "draft-edit",
            "from": "draft",
            "to": "draft",
            "step_id": "edit",
            "action_id": "edit",
            "title": "保存内容",
            "guard_description": "当前用户是所有者，标题非空且业务修订一致。"
          },
          {
            "id": "draft-submit",
            "from": "draft",
            "to": "submitted",
            "step_id": "edit",
            "action_id": "submit",
            "title": "提交",
            "guard_description": "当前用户是所有者，已保存说明且业务修订一致。"
          },
          {
            "id": "returned-edit",
            "from": "returned",
            "to": "returned",
            "step_id": "edit",
            "action_id": "edit",
            "title": "保存内容",
            "guard_description": "当前用户是所有者，标题非空且业务修订一致。"
          },
          {
            "id": "returned-submit",
            "from": "returned",
            "to": "submitted",
            "step_id": "edit",
            "action_id": "submit",
            "title": "提交",
            "guard_description": "当前用户是所有者，已保存说明且业务修订一致。"
          },
          {
            "id": "submitted-return",
            "from": "submitted",
            "to": "returned",
            "step_id": "inspect",
            "action_id": "return",
            "title": "模拟退回",
            "guard_description": "仅本人调试，处理说明非空且业务修订一致。"
          },
          {
            "id": "submitted-complete",
            "from": "submitted",
            "to": "completed",
            "step_id": "inspect",
            "action_id": "complete",
            "title": "模拟完成",
            "guard_description": "仅本人调试，处理说明非空且业务修订一致。"
          }
        ]
      }
    }
  ]
}
