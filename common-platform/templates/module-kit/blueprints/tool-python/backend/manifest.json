{
  "id": "__MODULE_ID__",
  "version": "1.0.0",
  "name": "__TITLE__",
  "description": "将纯文本整理能力接到平台页面和对话，使用机构范围授权。",
  "capabilities": [{
    "id": "__MODULE_ID__.analyze",
    "version": "1.0.0",
    "title": "整理与统计文本",
    "description": "统一换行和空白，返回字符、行和空白分隔片段数量。",
    "kind": "query",
    "handler": "handlers:analyze",
    "input_schema": {
      "type": "object",
      "properties": {"text": {"type": "string", "title": "待整理文本", "format": "textarea", "minLength": 1, "maxLength": 20000}},
      "required": ["text"], "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "normalized_text": {"type": "string", "minLength": 1, "maxLength": 20000},
        "character_count": {"type": "integer", "minimum": 1, "maximum": 20000},
        "line_count": {"type": "integer", "minimum": 1, "maximum": 20000},
        "segment_count": {"type": "integer", "minimum": 1, "maximum": 20000}
      },
      "required": ["normalized_text", "character_count", "line_count", "segment_count"],
      "additionalProperties": false
    },
    "roles": ["member"],
    "execution": {"mode": "sync", "confirmation": false},
    "presentation": {"page": {"renderer": "json"}, "conversation": {"renderer": "json"}}
  }],
  "surfaces": {
    "page_tools": [{"id": "text-tool", "title": "整理与统计文本", "description": "简单表单入口，与共享组件调用相同能力。", "kind": "form", "capability_ids": ["__MODULE_ID__.analyze"]}],
    "conversation": {"capability_ids": ["__MODULE_ID__.analyze"], "starter_prompts": ["打开文本整理工具"]}
  }
}
